generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/healthcare_portal/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  name          String
  role          String    @default("patient")
  avatar        String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  patientProfile  PatientProfile?
  doctorProfile   DoctorProfile?
  sentMessages    Message[]       @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  notifications   Notification[]

  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PatientProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  dob                   DateTime?
  gender                String?
  bloodType             String?  @map("blood_type")
  phone                 String?
  address               String?
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  insuranceProvider     String?  @map("insurance_provider")
  insurancePolicyNumber String?  @map("insurance_policy_number")
  insuranceGroupNumber  String?  @map("insurance_group_number")

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalHistory    MedicalHistory[]
  medications       Medication[]
  allergies         Allergy[]
  appointmentsAsPatient Appointment[] @relation("PatientAppointments")
  labResults        LabResult[]
  prescriptions     Prescription[]
  medicalDocuments  MedicalDocument[]
  billingRecords    Billing[]

  @@map("patient_profiles")
}

model DoctorProfile {
  id            String  @id @default(cuid())
  userId        String  @unique @map("user_id")
  specialty     String?
  licenseNumber String? @map("license_number")
  phone         String?
  bio           String?

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalHistories  MedicalHistory[]
  prescribedMeds    Medication[]      @relation("PrescribingDoctor")
  appointmentsAsDoctor Appointment[]  @relation("DoctorAppointments")
  labResults        LabResult[]
  prescriptions     Prescription[]
  medicalDocuments  MedicalDocument[]
  billingRecords    Billing[]

  @@map("doctor_profiles")
}

model MedicalHistory {
  id            String   @id @default(cuid())
  patientId     String   @map("patient_id")
  condition     String
  diagnosedDate DateTime? @map("diagnosed_date")
  status        String    @default("active")
  notes         String?
  doctorId      String?   @map("doctor_id")

  patient  PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor   DoctorProfile? @relation(fields: [doctorId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@map("medical_history")
}

model Medication {
  id                 String    @id @default(cuid())
  patientId          String    @map("patient_id")
  name               String
  dosage             String?
  frequency          String?
  startDate          DateTime? @map("start_date")
  endDate            DateTime? @map("end_date")
  prescribingDoctorId String?  @map("prescribing_doctor_id")
  status             String    @default("active")

  patient           PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescribingDoctor DoctorProfile? @relation("PrescribingDoctor", fields: [prescribingDoctorId], references: [id])

  @@index([patientId])
  @@index([prescribingDoctorId])
  @@map("medications")
}

model Allergy {
  id        String @id @default(cuid())
  patientId String @map("patient_id")
  allergen  String
  reaction  String?
  severity  String @default("moderate")

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("allergies")
}

model Appointment {
  id              String   @id @default(cuid())
  patientId       String   @map("patient_id")
  doctorId        String   @map("doctor_id")
  dateTime        DateTime @map("date_time")
  durationMinutes Int      @default(30) @map("duration_minutes")
  type            String   @default("in-person")
  status          String   @default("scheduled")
  reason          String?
  notes           String?

  patient  PatientProfile @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor   DoctorProfile  @relation("DoctorAppointments", fields: [doctorId], references: [id])
  billing  Billing?

  @@index([patientId])
  @@index([doctorId])
  @@index([dateTime])
  @@map("appointments")
}

model LabResult {
  id             String    @id @default(cuid())
  patientId      String    @map("patient_id")
  doctorId       String?   @map("doctor_id")
  testName       String    @map("test_name")
  resultValue    String?   @map("result_value")
  unit           String?
  referenceRange String?   @map("reference_range")
  status         String    @default("pending")
  orderedDate    DateTime? @map("ordered_date")
  resultDate     DateTime? @map("result_date")
  notes          String?
  fileUrl        String?   @map("file_url")
  isPublic       Boolean   @default(false) @map("is_public")

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  DoctorProfile? @relation(fields: [doctorId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@map("lab_results")
}

model Prescription {
  id              String    @id @default(cuid())
  patientId       String    @map("patient_id")
  doctorId        String?   @map("doctor_id")
  medicationName  String    @map("medication_name")
  dosage          String?
  instructions    String?
  issuedDate      DateTime? @map("issued_date")
  expiryDate      DateTime? @map("expiry_date")
  fileUrl         String?   @map("file_url")
  isPublic        Boolean   @default(false) @map("is_public")
  status          String    @default("active")

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  DoctorProfile? @relation(fields: [doctorId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@map("prescriptions")
}

model MedicalDocument {
  id         String   @id @default(cuid())
  patientId  String   @map("patient_id")
  doctorId   String?  @map("doctor_id")
  title      String
  type       String?
  fileUrl    String?  @map("file_url")
  isPublic   Boolean  @default(false) @map("is_public")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  notes      String?

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  DoctorProfile? @relation(fields: [doctorId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@map("medical_documents")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  subject    String?
  body       String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")
  parentId   String?  @map("parent_id")

  sender   User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  parent   Message?  @relation("MessageThread", fields: [parentId], references: [id])
  replies  Message[] @relation("MessageThread")

  @@index([senderId])
  @@index([receiverId])
  @@index([parentId])
  @@map("messages")
}

model Billing {
  id            String    @id @default(cuid())
  patientId     String    @map("patient_id")
  doctorId      String?   @map("doctor_id")
  appointmentId String?   @unique @map("appointment_id")
  description   String
  amount        Float
  status        String    @default("pending")
  dueDate       DateTime? @map("due_date")
  paidDate      DateTime? @map("paid_date")

  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      DoctorProfile? @relation(fields: [doctorId], references: [id])
  appointment Appointment?   @relation(fields: [appointmentId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@map("billing")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  link      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
